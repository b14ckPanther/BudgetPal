# ── Mobile public (EAS Build + local dev) ─────────────────
# Baked into the app bundle. Use HTTPS origins only for release builds.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Required for release builds. In dev, Metro host fallback is used when unset.
EXPO_PUBLIC_API_BASE_URL=

# ── Server-only (EAS Hosting deploy — never EXPO_PUBLIC_*) ─
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Optional server model overrides (defaults: gpt-4o-mini)
# REPORT_AI_MODEL=
# RECEIPT_VISION_MODEL=

# Local dev only — presentation demo account (scripts/demo-provision-noor.mjs). Never commit.
# DEMO_NOOR_PASSWORD=

# Staging smoke tests (scripts/smoke-test-staging.mjs). Never commit.
# STAGING_API_BASE_URL=https://your-deployment.expo.app
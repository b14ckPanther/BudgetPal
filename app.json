{
  "expo": {
    "name": "BudgetPal",
    "slug": "budgetpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budgetpal",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.budgetpal.app",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "he"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#080B12"
      },
      "package": "com.budgetpal.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B12"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "BudgetPal needs microphone access to record voice expenses. | BudgetPal זקוקה לגישה למיקרופון כדי לתעד הוצאות בקול."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BudgetPal needs photo access to import receipt images. | BudgetPal זקוקה לגישה לתמונות כדי לייבא תמונות קבלות.",
          "cameraPermission": "BudgetPal needs camera access to photograph receipts. | BudgetPal זקוקה לגישה למצלמה כדי לצלם קבלות."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4ADEB2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
